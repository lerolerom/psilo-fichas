{
  "name": "despertar-setter",
  "version": "0.1.0",
  "private": true,
  "description": "Agente setter de Despertar sobre WhatsApp Cloud API (coexistencia) y Claude",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "importar-duenos": "tsx scripts/importar-duenos.ts",
    "simular": "tsx scripts/simular.ts",
    "autorizar-google": "tsx scripts/autorizar-google.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
