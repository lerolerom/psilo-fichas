# ---- Claude ----
ANTHROPIC_API_KEY=
# Inteligencia escalonada: Haiku para lo rutinario, Sonnet para precio, objeciones, reflejo y comprobantes,
# Opus solo si un nivel inferior no lo resuelve. claude-opus-5-5 es más barato y más capaz que claude-opus-5.
MODELO_BASICO=claude-haiku-5-5
MODELO_MEDIO=claude-sonnet-5-5
MODELO_SUPERIOR=claude-opus-5
EFFORT_BASICO=medium
EFFORT_MEDIO=medium
EFFORT_SUPERIOR=high
PRESUPUESTO_MENSUAL_USD=45     # al llegar, solo Haiku hasta fin de mes (el agente nunca deja de contestar)

# ---- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # token permanente de un usuario del sistema (Business Manager)
WA_APP_SECRET=              # Configuración de la app > Básica > Clave secreta
WA_VERIFY_TOKEN=            # inventa una cadena larga; la misma va en la configuración del webhook
WA_GRAPH_VERSION=v23.0
META_PAGE_ACCESS_TOKEN=     # opcional: para leer leads de formularios instantáneos (webhook leadgen)

# ---- Operación ----
MODO=sombra                 # sombra (decide sin enviar, para comparar) | hibrido | aprobacion | pausado
SEGUIMIENTO_FUERA_DE_VENTANA=chrome   # chrome (el agente redacta, las rondas envían) | plantillas
URL_PUBLICA=                # https://... del servidor, para los enlaces del panel en el reporte
ADMIN_NUMEROS=593XXXXXXXXX  # WhatsApp personal de Mario (y Dani), separados por coma
NOTIFICAR_A=                # vacío = ADMIN_NUMEROS
DUENO_POR_DEFECTO=MARIO
PRESENTACION_MARIO=Mario
PRESENTACION_DANI=          # vacío = pendiente: el primer mensaje de chats de Dani se deja a Mario

# Tiempo de "lectura" antes de contestar (minutos, al azar). Se contesta las 24 horas.
LECTURA_MIN_MINUTOS=3
LECTURA_MAX_MINUTOS=10
ESPERA_TRAS_MARIO_MINUTOS=10   # si Mario escribió desde la app, margen antes de que conteste el agente
# Seguimientos: lunes a viernes, alternando estas franjas, a una hora al azar dentro de cada una
FRANJAS_SEGUIMIENTO=09:00-12:00,15:00-18:30
HORARIO_EVALUACIONES=09:00-19:00
FERIADOS=2026-12-25,2027-01-01
HORA_REPORTE_DIARIO=07:50
AVISOS_INMEDIATOS=riesgo,reclamo,caliente,identidad
MAX_MENSAJES_HORA=60
ADMIN_API_TOKEN=            # para POST /api/leads y GET /api/leads.csv

# ---- Datos del negocio (manual, sección 4). No se guardan en el código. ----
# Cuenta para la transferencia de $40, líneas separadas por "|", tal como está en la tabla del manual:
DATOS_TRANSFERENCIA=Banco: PRODUBANCO|Cuenta de ahorros: XXXXXXXXXXX|Titular: XXXXXXXX|CI: XXXXXXXXXX|Mail: XXXXXXXX
DIRECCION_CUMBAYA=          # se envía solo a quien pagó y eligió presencial
MAPS_URL=
TELEFONO_DANIELA=           # para quien acepta la terapia psicológica con Daniela
VIDEO_EDUCATIVO_URL=https://youtu.be/cuMOrmOdzIU
TESTIMONIOS_URL=https://youtube.com/playlist?list=PLi-B534urCtaEamepwTBLf7-zsGvprNho
FORMULARIO_EVALUACION_URL=https://forms.gle/wwHVNHk3GUw1B2Sg6
DURACION_EVALUACION_MIN=45

# ---- Audios (Whisper en el mismo servidor; docker-compose lo levanta) ----
WHISPER_URL=http://whisper:8000
WHISPER_MODELO=Systran/faster-whisper-small

# ---- Google Calendar de Mario (npm run autorizar-google para obtener el refresh token) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Meta: API de Conversiones (Administrador de eventos) para que Meta aprenda qué leads califican ----
META_DATASET_ID=
META_CAPI_TOKEN=
META_WABA_ID=               # ID de la cuenta de WhatsApp Business
META_NOMBRE_CRM=Despertar Setter
META_EVENTOS_WHATSAPP=Qualified:QualifiedLead,Agendo sesion Evaluacion:Schedule,Converted:Purchase

# ---- Plantillas (nombres tal cual se aprobaron en Meta) ----
PLANTILLA_IDIOMA=es
PLANTILLA_ALERTA=alerta_setter
PLANTILLA_PRIMER_CONTACTO=primer_contacto_formulario
PLANTILLA_PRIMER_CONTACTO_SIN_RESPUESTA=primer_contacto_sin_respuesta
PLANTILLA_ABANDONADO=primer_contacto_abandonado
PLANTILLA_RECORDATORIO_EVALUACION=recordatorio_evaluacion
PLANTILLA_RECONEXION_1=reconexion_1
PLANTILLA_RECONEXION_2=reconexion_2
PLANTILLA_RECONEXION_3=reconexion_3
PLANTILLA_SEGUIMIENTO_CONTACTADO=seguimiento_contactado_1,seguimiento_contactado_2
PLANTILLA_SEGUIMIENTO_CONVERSANDO=seguimiento_conversando_1,seguimiento_conversando_2
PLANTILLA_SEGUIMIENTO_OFRECIDO=seguimiento_ofrecido_1,seguimiento_ofrecido_2
