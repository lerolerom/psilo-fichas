# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ---- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # token permanente de un usuario del sistema (Business Manager)
WA_APP_SECRET=              # Configuración de la app > Básica > Clave secreta
WA_VERIFY_TOKEN=            # inventa una cadena larga; la misma va en la configuración del webhook
WA_GRAPH_VERSION=v23.0
META_PAGE_ACCESS_TOKEN=     # opcional: para leer leads de formularios instantáneos (webhook leadgen)

# ---- Operación ----
MODO=hibrido                # hibrido | aprobacion | pausado
ADMIN_NUMEROS=593XXXXXXXXX  # WhatsApp personal de Mario (y Dani), separados por coma
NOTIFICAR_A=                # vacío = ADMIN_NUMEROS
DUENO_POR_DEFECTO=MARIO
PRESENTACION_MARIO=Mario
PRESENTACION_DANI=          # vacío = pendiente: el agente escala el primer mensaje de chats de Dani
VIDEO_EDUCATIVO_URL=
DEBOUNCE_SEGUNDOS=90        # espera a que el lead termine de escribir antes de responder
HUMANO_SILENCIO_HORAS=12    # si alguien escribe desde la app, el agente calla este tiempo
HORA_INICIO_ENVIO=8
HORA_FIN_ENVIO=21
FERIADOS=2026-12-25,2027-01-01
MAX_MENSAJES_HORA=60
ADMIN_API_TOKEN=            # para POST /api/leads y GET /api/leads.csv

# ---- Plantillas (nombres tal cual se aprobaron en Meta) ----
PLANTILLA_IDIOMA=es
PLANTILLA_ALERTA=alerta_setter
PLANTILLA_PRIMER_CONTACTO=primer_contacto_formulario
PLANTILLA_PRIMER_CONTACTO_SIN_RESPUESTA=primer_contacto_sin_respuesta
PLANTILLA_SEGUIMIENTO_CONTACTADO=seguimiento_contactado_1,seguimiento_contactado_2
PLANTILLA_SEGUIMIENTO_CONVERSANDO=seguimiento_conversando_1,seguimiento_conversando_2
PLANTILLA_SEGUIMIENTO_OFRECIDO=seguimiento_ofrecido_1,seguimiento_ofrecido_2

# ---- Google Calendar (opcional) ----
GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON completo de la cuenta de servicio, en una línea
GOOGLE_CALENDAR_ID=            # calendario de evaluaciones compartido con la cuenta de servicio
